{
  "name": "mre-sf-plugin-flags-dir",
  "version": "0.0.0-development",
  "keywords": [
    "sfdx-plugin",
    "sf-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdapi-issues/mre-sf-plugin-flags-dir.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "/bin/run.js",
    "/lib",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p . && oclif manifest",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "tsc -p test && mocha \"test/**/*.test.ts\""
  },
  "mocha": {
    "loader": "ts-node/esm",
    "no-warnings": "ExperimentalWarning"
  },
  "oclif": {
    "additionalHelpFlags": [
      "-h"
    ],
    "bin": "sf",
    "commands": "./lib/commands",
    "topicSeparator": " "
  },
  "dependencies": {
    "@salesforce/sf-plugins-core": "13.0.0"
  },
  "devDependencies": {
    "@salesforce/dev-scripts": "13.0.2",
    "oclif": "4.23.30"
  }
}
